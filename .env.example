# Copie para .env (na raiz do projeto, ao lado do README) e preencha.
# Sem DATABASE_URL, o jogo usa SQLite local (umaworld.db). Passo a passo: GUIA_BANCO_DE_DADOS.md
# O .env está no .gitignore: nunca faça commit dele.

# Assina os logins (JWT). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Supabase: botão Connect > Session pooler > URI. Cole do jeito que vem, com [YOUR-PASSWORD].
DATABASE_URL=
# A senha do banco (a que você definiu ao criar o projeto no Supabase), sem aspas.
DATABASE_PASSWORD=

# Fuso dos resets diários/semanais e da rotação de banners
GAME_TIMEZONE=America/Sao_Paulo

# Validade do login (horas)
TOKEN_TTL_HOURS=168
